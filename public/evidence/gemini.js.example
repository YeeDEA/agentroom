import { getApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
import {
  getAI,
  getGenerativeModel,
  GoogleAIBackend,
} from "https://www.gstatic.com/firebasejs/11.6.1/firebase-ai.js";

// File → base64 (inlineData용)
async function fileToBase64(file) {
  const buf = await file.arrayBuffer();
  let bin = "";
  const bytes = new Uint8Array(buf);
  for (let i = 0; i < bytes.length; i++) bin += String.fromCharCode(bytes[i]);
  return btoa(bin);
}

async function analyze(ctx) {
  const t0 = performance.now();
  try {
    const ai = getAI(getApp(), { backend: new GoogleAIBackend() });
    const model = getGenerativeModel(ai, {
      model: "gemini-2.5-flash",
      // JSON 모드: 구조화된 응답을 강제
      generationConfig: {
        responseMimeType: "application/json",
      },
    });

    const prompt = `이 이미지를 위변조 관점에서 분석해 주세요.
다음 JSON 형식으로만 답하세요:
{
  "aiLikelihood": 0~1 사이 숫자,        // AI 생성/합성 가능성
  "ocrInconsistencies": ["..."],       // 글자·숫자·폰트의 모순 (영수증 금액, 날짜 등)
  "visualAnomalies": ["..."],          // 시각적 이상 징후 (손가락 개수, 그림자 방향, 비현실적 질감 등)
  "summary": "쉬운 한국어 한 줄 요약"
}`;

    const result = await model.generateContent([
      { inlineData: { mimeType: ctx.file.type, data: await fileToBase64(ctx.file) } },
      { text: prompt },
    ]);
    const parsed = JSON.parse(result.response.text());

    return {
      id: "gemini",
      title: "AI 시각 정밀 분석 (Gemini)",
      signal: typeof parsed.aiLikelihood === "number" ? parsed.aiLikelihood : null,
      verdictText: parsed.summary || "분석 결과를 요약하지 못했습니다",
      details: [
        ...(parsed.ocrInconsistencies || []).map((v) => ({
          label: "글자 모순",
          value: v,
          meaning: "문서·영수증 등의 글자와 숫자가 서로 맞지 않는 부분",
        })),
        ...(parsed.visualAnomalies || []).map((v) => ({
          label: "시각적 이상",
          value: v,
          meaning: "AI 생성물에서 흔히 보이는 부자연스러운 부분",
        })),
      ],
      available: true,
      elapsedMs: performance.now() - t0,
    };
  } catch (err) {
    return {
      id: "gemini",
      title: "AI 시각 정밀 분석 (Gemini)",
      signal: null,
      verdictText: `이 검사를 수행하지 못했습니다: ${err && err.message ? err.message : "알 수 없는 오류"}`,
      details: [],
      available: true,
      elapsedMs: performance.now() - t0,
    };
  }
}

export default {
  id: "gemini",
  title: "AI 시각 정밀 분석 (Gemini)",
  order: 3,
  available: true,
  analyze,
};
